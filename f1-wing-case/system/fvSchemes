FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         cellLimited Gauss Linear 1;
    div(phi,U)      cellLimited Gauss Linear 1;
    div(phi,k)      cellLimited Gauss Linear 1;
    div(phi,epsilon) cellLimited Gauss Linear 1;
    div(phi,omega)  cellLimited Gauss Linear 1;
    div(phi,v2)     cellLimited Gauss Linear 1;
    div((nuEff*dev2(T(grad(U))))) cellLimited Gauss Linear 1;
    div(nonlinearStress) cellLimited Gauss Linear 1;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method meshWave;
}


